#include <stdio.h>
#include <string.h>

int main(int argc, char *argv[])
{
    if(argc != 2)
    {
        printf("Usage: program.exe string\n");
        return 1;
    }

    int i, len = strlen(argv[1]);
    int flag = 1;

    for(i = 0; i < len / 2; i++)
    {
        if(argv[1][i] != argv[1][len - 1 - i])
        {
            flag = 0;
            break;
        }
    }

    if(flag)
        printf("Palindrome\n");
    else
        printf("Not Palindrome\n");

    return 0;
}
