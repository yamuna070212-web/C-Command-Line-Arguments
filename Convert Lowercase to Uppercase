#include <stdio.h>
#include <ctype.h>

int main(int argc, char *argv[])
{
    if(argc != 2)
    {
        printf("Usage: program.exe string\n");
        return 1;
    }

    int i = 0;

    while(argv[1][i] != '\0')
    {
        printf("%c", toupper(argv[1][i]));
        i++;
    }

    printf("\n");

    return 0;
}
Run
program.exe hello
Output
HELLO
