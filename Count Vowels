#include <stdio.h>
#include <ctype.h>

int main(int argc, char *argv[])
{
    if(argc != 2)
    {
        printf("Usage: program.exe string\n");
        return 1;
    }

    int i, count = 0;

    for(i = 0; argv[1][i] != '\0'; i++)
    {
        char ch = tolower(argv[1][i]);

        if(ch=='a'||ch=='e'||ch=='i'||ch=='o'||ch=='u')
            count++;
    }

    printf("Vowels = %d\n", count);

    return 0;
}
