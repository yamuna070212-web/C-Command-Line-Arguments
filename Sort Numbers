#include <stdio.h>
#include <stdlib.h>

int main(int argc, char *argv[])
{
    int i, j;

    if(argc < 2)
    {
        printf("Usage: program.exe numbers...\n");
        return 1;
    }

    int arr[100];

    for(i = 1; i < argc; i++)
        arr[i - 1] = atoi(argv[i]);

    int n = argc - 1;

    for(i = 0; i < n - 1; i++)
    {
        for(j = 0; j < n - i - 1; j++)
        {
            if(arr[j] > arr[j + 1])
            {
                int temp = arr[j];
                arr[j] = arr[j + 1];
                arr[j + 1] = temp;
            }
        }
    }

    printf("Sorted: ");

    for(i = 0; i < n; i++)
        printf("%d ", arr[i]);

    return 0;
}
Run
program.exe 50 10 30 20
Output
Sorted: 10 20 30 50
