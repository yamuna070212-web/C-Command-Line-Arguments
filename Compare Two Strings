#include <stdio.h>
#include <string.h>

int main(int argc, char *argv[])
{
    if(argc != 3)
    {
        printf("Usage: program.exe string1 string2\n");
        return 1;
    }

    if(strcmp(argv[1], argv[2]) == 0)
        printf("Strings are Equal\n");
    else
        printf("Strings are Not Equal\n");

    return 0;
}
Run
program.exe Apple Apple
Output
Strings are Equal
