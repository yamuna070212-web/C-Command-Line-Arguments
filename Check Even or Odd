#include <stdio.h>
#include <stdlib.h>

int main(int argc, char *argv[])
{
    if(argc != 2)
    {
        printf("Usage: program.exe number\n");
        return 1;
    }

    int n = atoi(argv[1]);

    if(n % 2 == 0)
        printf("Even\n");
    else
        printf("Odd\n");

    return 0;
}
Run
program.exe 17
Output
Odd
