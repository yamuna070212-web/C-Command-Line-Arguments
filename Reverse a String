#include <stdio.h>
#include <string.h>

int main(int argc, char *argv[])
{
    if(argc != 2)
    {
        printf("Usage: program.exe string\n");
        return 1;
    }

    int i;

    for(i = strlen(argv[1]) - 1; i >= 0; i--)
    {
        printf("%c", argv[1][i]);
    }

    printf("\n");

    return 0;
}
