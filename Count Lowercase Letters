#include <stdio.h>
#include <ctype.h>

int main(int argc, char *argv[])
{
    if(argc != 2)
    {
        printf("Usage: program.exe string\n");
        return 1;
    }

    int count = 0;

    for(int i = 0; argv[1][i] != '\0'; i++)
    {
        if(islower(argv[1][i]))
            count++;
    }

    printf("Lowercase Letters = %d\n", count);

    return 0;
}
Run
program.exe HeLLo
