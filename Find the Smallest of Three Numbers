#include <stdio.h>
#include <stdlib.h>

int main(int argc, char *argv[])
{
    if(argc != 4)
    {
        printf("Usage: program.exe num1 num2 num3\n");
        return 1;
    }

    int a = atoi(argv[1]);
    int b = atoi(argv[2]);
    int c = atoi(argv[3]);

    int smallest = a;

    if(b < smallest)
        smallest = b;

    if(c < smallest)
        smallest = c;

    printf("Smallest = %d\n", smallest);

    return 0;
}
Run
program.exe 25 10 40
Output
Smallest = 10
