#include <stdio.h>
#include <string.h>

int main(int argc, char *argv[])
{
    int i, j;

    if(argc != 2)
    {
        printf("Usage: program.exe string\n");
        return 1;
    }

    for(i = 0; argv[1][i] != '\0'; i++)
    {
        int duplicate = 0;

        for(j = 0; j < i; j++)
        {
            if(argv[1][i] == argv[1][j])
            {
                duplicate = 1;
                break;
            }
        }

        if(!duplicate)
            printf("%c", argv[1][i]);
    }

    printf("\n");

    return 0;
}
