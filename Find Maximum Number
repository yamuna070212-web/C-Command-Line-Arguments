#include <stdio.h>
#include <stdlib.h>

int main(int argc, char *argv[])
{
    if(argc < 2)
    {
        printf("Usage: program.exe numbers...\n");
        return 1;
    }

    int max = atoi(argv[1]);

    for(int i = 2; i < argc; i++)
    {
        if(atoi(argv[i]) > max)
            max = atoi(argv[i]);
    }

    printf("Maximum = %d\n", max);

    return 0;
}
Run
program.exe 12 45 67 23
Output
Maximum = 67
