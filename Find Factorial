#include <stdio.h>
#include <stdlib.h>

int main(int argc, char *argv[])
{
    if(argc != 2)
    {
        printf("Usage: program.exe number\n");
        return 1;
    }

    int n = atoi(argv[1]);
    int fact = 1, i;

    for(i = 1; i <= n; i++)
        fact *= i;

    printf("Factorial = %d\n", fact);

    return 0;
}
Run
program.exe 5
Output
Factorial = 120
