#include <stdio.h>
#include <string.h>

int main(int argc, char *argv[])
{
    if(argc != 2)
    {
        printf("Usage: program.exe number\n");
        return 1;
    }

    int len = strlen(argv[1]);

    printf("Reverse = ");

    for(int i = len - 1; i >= 0; i--)
    {
        printf("%c", argv[1][i]);
    }

    printf("\n");

    return 0;
}
Run
program.exe 12345
Output
Reverse = 54321
